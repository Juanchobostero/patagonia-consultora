---
import { SITE, SOCIAL } from '../consts';
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-top">
    <div class="footer-brand"><img src="/logo.png" alt="Patagonia Consultora" width="140" height="34" /></div>
    <div class="footer-cols">
      <div class="footer-col">
        <h5>Secciones</h5>
        <a href="#soluciones">Soluciones</a>
        <a href="#trabajamos">Cómo trabajamos</a>
        <a href="#nosotros">Quiénes somos</a>
      </div>
      <div class="footer-col">
        <h5>Contacto</h5>
        <a href="#contacto">{SITE.location}</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href="tel:+54299578813">{SITE.phoneDisplay}</a>
        <div class="footer-social">
          <a class="social-whatsapp" href={SOCIAL.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.79.47 3.47 1.29 4.92L2 22l5.31-1.39a9.87 9.87 0 0 0 4.73 1.2h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.51 2 12.04 2Zm5.79 14.12c-.24.68-1.4 1.3-1.93 1.35-.5.05-1.02.24-3.4-.71-2.88-1.14-4.74-4.07-4.88-4.26-.14-.19-1.17-1.55-1.17-2.96 0-1.41.74-2.1 1-2.39.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.82 2 .89 2.14.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.13.57.17.29.75 1.24 1.61 2.01 1.11.99 2.04 1.3 2.33 1.44.29.14.46.12.63-.07.17-.19.72-.84.92-1.13.19-.29.38-.24.65-.14.26.1 1.68.79 1.97.94.29.14.48.21.55.33.07.12.07.68-.17 1.36Z"/></svg>
          </a>
          <a class="social-linkedin" href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065Zm1.782 13.019H3.555V9h3.564v11.452Z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>Patagonia Consultora · Soluciones Integrales · Neuquén, Argentina · {year}</span>
    <span>Gestión Documental · Personas y Nómina · Auditoría · Legal</span>
  </div>
</footer>
